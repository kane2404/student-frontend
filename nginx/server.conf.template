server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Le backend est résolu à l'exécution (et non au démarrage de nginx) : nginx démarre même si
  # le backend n'est pas encore déployé, et suit les changements d'IP du Service.
  # Attention : le resolver de nginx ignore les "search domains" -> utiliser un nom complet (FQDN).
  resolver __RESOLVER__ valid=10s;
  set $backend "__BACKEND_URL__";

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "same-origin" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  # Sonde de vie / disponibilité du pod frontend
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # API : proxy vers le backend (l'URI d'origine, /api/..., est transmise telle quelle)
  location /api/ {
    client_max_body_size 128k;
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 3s;
    proxy_read_timeout 30s;
  }

  # Application statique. Les fichiers ne sont pas empreintés : on force la revalidation.
  location / {
    try_files $uri $uri/ =404;
    expires -1;
  }
}
